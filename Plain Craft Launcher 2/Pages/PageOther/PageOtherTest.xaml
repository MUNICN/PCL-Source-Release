<local:MyPageRight x:Class="PageOtherTest"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:local="clr-namespace:PCL"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,10">

            <local:MyCard Margin="0,15" Title="百宝箱">
                <Grid Margin="21,40,21,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <local:MyButton x:Name="BtnJrrp" Text="今日人品" Grid.Column="0" Height="34" />
                    <local:MyButton x:Name="BtnMemory" Text="内存优化" Grid.Column="2" Height="34" />
                    <local:MyButton x:Name="BtnClear" Text="清理游戏垃圾" Grid.Column="4" Height="34" />
                    <local:MyButton x:Name="BtnClick" Text="千万别点" Grid.Column="6" Height="34" ColorType="Red" />
                </Grid>
            </local:MyCard>

            <local:MyCard Margin="0,0,0,15" Title="回声洞" x:Name="CardCave">
                <Grid Margin="21,40,21,16">
                    <TextBlock x:Name="LabCave" TextWrapping="Wrap" FontSize="13.5" LineHeight="21"
                               Foreground="{DynamicResource ColorBrush1}"
                               Text="反复点击这里可以查看 PCL 作者与各位沙雕网友乱七八糟的留言！" />
                </Grid>
            </local:MyCard>

            <local:MyCard Margin="0,0,0,15" Title="下载自定义文件">
                <Grid Margin="21,40,21,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.ColumnSpan="3" TextWrapping="Wrap" FontSize="12.5" LineHeight="20"
                               Foreground="{DynamicResource ColorBrush1}" Opacity="0.85" Margin="0,0,0,6"
                               Text="使用 PCL 的高速多线程下载引擎下载任意文件。请注意，部分网站（例如百度网盘）可能会报错（403）已禁止，无法正常下载。" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="下载地址" VerticalAlignment="Center" FontSize="13" />
                    <local:MyTextBox x:Name="TextDownloadUrl" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                     Margin="0,4,0,4" HintText="http:// 或 https:// 开头的完整链接" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="保存到" VerticalAlignment="Center" FontSize="13" />
                    <local:MyTextBox x:Name="TextDownloadFolder" Grid.Row="2" Grid.Column="1" Margin="0,4,8,4" />
                    <local:MyTextButton x:Name="BtnDownloadSelect" Grid.Row="2" Grid.Column="2" Text="选择"
                                        VerticalAlignment="Center" Margin="0,4,0,4" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="文件名" VerticalAlignment="Center" FontSize="13" />
                    <local:MyTextBox x:Name="TextDownloadName" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                                     Margin="0,4,0,4" HintText="留空则用链接里的文件名" />

                    <StackPanel Grid.Row="4" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                        <local:MyButton x:Name="BtnDownloadStart" Text="开始下载" MinWidth="110" Height="34" ColorType="Highlight" Margin="0,0,10,0" />
                        <local:MyButton x:Name="BtnDownloadOpen" Text="打开文件夹" MinWidth="110" Height="34" />
                    </StackPanel>
                </Grid>
            </local:MyCard>

        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
